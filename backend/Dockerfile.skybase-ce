# Skybase's CE-only image. Build from the backend context:
# docker build -f Dockerfile.skybase-ce -t skybase-onyx-ce .
FROM docker.io/library/python:3.13-slim@sha256:b04b5d7233d2ad9c379e22ea8927cd1378cd15c60d4ef876c065b25ea8fb3bf3 AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11.25@sha256:1e3808aa9023d0980e7c15b1fa7c1ac16ff35925780cf5c459858b2d693f01a9 /uv /uvx /bin/

RUN apt-get update && \
    apt-get install -y \
        ca-certificates \
        cmake \
        gcc \
        libxmlsec1-dev \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

COPY ./requirements/default.txt /tmp/requirements/default.txt
COPY ./requirements/skybase-ce.txt /tmp/requirements/skybase-ce.txt
RUN uv pip install --system --no-cache-dir --no-deps --require-hashes \
        -r /tmp/requirements/skybase-ce.txt && \
    rm -f /usr/local/lib/python3.13/site-packages/tornado/test/test.key && \
    rm -rf /root/.cache/uv /tmp/requirements

FROM docker.io/library/python:3.13-slim@sha256:b04b5d7233d2ad9c379e22ea8927cd1378cd15c60d4ef876c065b25ea8fb3bf3 AS runtime

LABEL org.opencontainers.image.source="https://github.com/onyx-dot-app/onyx" \
    org.opencontainers.image.revision="c8ba005da719ad880afbff08b067241eb3f9adc1" \
    io.skybase.upstream.tag="v4.3.1" \
    io.skybase.upstream.tree="25e636429b1161a161aabfa40e9b29cf4b70b778"

ENV DO_NOT_TRACK="true" \
    ENABLE_PAID_ENTERPRISE_EDITION_FEATURES="false" \
    LICENSE_ENFORCEMENT_ENABLED="false" \
    ONYX_RUNNING_IN_DOCKER="true" \
    PYTHONPATH="/app"

RUN groupadd -g 1001 onyx && \
    useradd -u 1001 -g onyx -m -s /bin/bash onyx && \
    mkdir -p /var/log/onyx && \
    chown onyx:onyx /var/log/onyx && \
    apt-get update && \
    apt-get install -y \
        ca-certificates \
        curl \
        libblkid1 \
        libgnutls30 \
        libjemalloc2 \
        libmount1 \
        libsmartcols1 \
        libuuid1 \
        libxmlsec1-openssl && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder \
    /usr/local/bin/alembic \
    /usr/local/bin/celery \
    /usr/local/bin/supervisord \
    /usr/local/bin/uvicorn \
    /usr/local/bin/

WORKDIR /app

COPY --chown=onyx:onyx ./alembic /app/alembic
COPY --chown=onyx:onyx ./alembic.ini /app/alembic.ini
COPY --chown=onyx:onyx ./onyx /app/onyx
COPY --chown=onyx:onyx ./shared_configs /app/shared_configs
COPY --chown=onyx:onyx ./static /app/static
COPY ./supervisord.skybase-ce.conf /etc/supervisor/conf.d/supervisord.conf

USER onyx

CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
